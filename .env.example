# ─── Database ─────────────────────────────────────────────────────────────
POSTGRES_USER=society
POSTGRES_PASSWORD=society_dev_password
POSTGRES_DB=society
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://society:society_dev_password@postgres:5432/society
SYNC_DATABASE_URL=postgresql://society:society_dev_password@postgres:5432/society

# ─── Object storage (MinIO locally, R2 in prod) ───────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minio_admin
S3_SECRET_ACCESS_KEY=minio_admin_password
S3_BUCKET=society-media
S3_REGION=auto
S3_PUBLIC_BASE_URL=http://localhost:9000

# ─── Claude API ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx-replace-me
CLAUDE_CONVERSATION_MODEL=claude-sonnet-4-6
CLAUDE_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# ─── Skills service ───────────────────────────────────────────────────────
SKILLS_HTTP_HOST=0.0.0.0
SKILLS_HTTP_PORT=8080
SKILLS_HTTP_INTERNAL_TOKEN=replace-with-long-random-string
SKILLS_MEDIA_URL_TTL_SECONDS=900

# ─── OpenCLAW bridge ──────────────────────────────────────────────────────
# Outbound bridge — skills service POSTs here to send a WhatsApp message
# through the OpenCLAW gateway. Implementation depends on the OpenCLAW
# version's outbound HTTP plugin; sane default points to the local gateway.
OPENCLAW_OUTBOUND_URL=http://openclaw:7787/v1/messages
OPENCLAW_OUTBOUND_TOKEN=replace-with-long-random-string

# Admin alert routing — WhatsApp JID(s) to fan out CRITICAL complaints to.
# Comma-separated. e.g. "9198xxxxxxxx@s.whatsapp.net,9197yyyyyyyy@s.whatsapp.net"
# Or a group JID like "120363xxxxxxxxxx@g.us".
ADMIN_ALERT_JIDS=

# ─── Admin portal (Next.js) ───────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-long-random-string
SKILLS_API_BASE_URL=http://skills:8080
SKILLS_API_TOKEN=replace-with-long-random-string

# Initial bootstrap admin (created on first portal startup if no admins exist).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme-on-first-login

# ─── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
