# --- OpenAI (transcription + insight extraction) ---
OPENAI_API_KEY=sk-...
# whisper-1 returns segment timestamps (needed for diarization + quotes).
# gpt-4o-transcribe is higher quality but returns no segment timestamps.
OPENAI_STT_MODEL=whisper-1
OPENAI_EXTRACT_MODEL=gpt-4o
OPENAI_DIARIZE_MODEL=gpt-4o-mini

# --- Neo4j (knowledge graph) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=talkgraph-dev

# --- Local storage for audio + transcript artifacts ---
DATA_DIR=./data
